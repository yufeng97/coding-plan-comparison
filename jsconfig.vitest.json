{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.test.js",
    "src/test/**/*.js",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "js/**/*.js",
    "js/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

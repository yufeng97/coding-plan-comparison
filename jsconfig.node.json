{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.js", "scripts/**/*.mjs", "playwright.config.js"],
  "exclude": ["node_modules"]
}

{
  "name": "coding-plan-comparison",
  "private": true,
  "version": "1.0.0",
  "description": "国内外 AI Coding Plan（编程订阅计划）价格与 token 额度可视化对比",
  "scripts": {
    "serve": "node scripts/server/serve.js",
    "validate": "node scripts/build/validate-data.js",
    "test": "node scripts/tests/run.js",
    "bump": "node scripts/build/bump-versions.js",
    "check": "node scripts/build/check-syntax.js",
    "typecheck": "tsc -p jsconfig.json && tsc -p jsconfig.node.json",
    "test:tools": "node scripts/tests/test-tools.js",
    "news:collect": "node scripts/news/collect-news.js",
    "news:review": "node scripts/news/review-news.js",
    "pricing:sync": "node scripts/build/sync-pricing-audit.js",
    "rates:update": "node scripts/build/update-rates.js",
    "maintenance:build": "node scripts/maintenance/build-maintenance.js",
    "benchmark:run": "node scripts/benchmarks/benchmark.js run",
    "benchmark:collect": "node scripts/benchmarks/public-scores.js collect",
    "benchmark:publish": "node scripts/benchmarks/public-scores.js publish",
    "benchmark:import": "node scripts/benchmarks/benchmark.js import",
    "benchmark:validate": "node scripts/benchmarks/benchmark.js validate",
    "benchmark:build": "node scripts/benchmarks/benchmark.js build",
    "benchmark:check": "node scripts/benchmarks/benchmark.js check",
    "maintenance:check": "node scripts/maintenance/build-maintenance.js --check",
    "test:news": "node scripts/tests/test-news.js && node scripts/tests/test-news-blog.js && node scripts/tests/test-news-blog-collection.js",
    "test:browser": "playwright test",
    "cache:check": "node scripts/build/bump-versions.js --check",
    "vendor:fonts": "node scripts/build/vendor-fonts.js",
    "vendor:echarts": "node scripts/build/rebuild-echarts.js",
    "render:og": "node scripts/build/render-og-image.js",
    "build:site": "node scripts/build/stage-site.js",
    "deploy": "node scripts/build/deploy-site.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}

/* ============ Coding Plan 比价中心 样式 ============ */
:root {
  --bg: #0a0e1a;
  --bg-soft: #0e1424;
  --card: #121a2e;
  --card-2: #16203a;
  --border: rgba(255,255,255,.08);
  --text: #e7ecf7;
  --text-dim: #9aa7c2;
  --text-faint: #8b98b8;
  --accent: #6366f1;
  --accent-2: #22d3ee;
  --gold: #f59e0b;
  --green: #34d399;
  --red: #f87171;
  --hover: rgba(255,255,255,.06);
  --chip-bg: rgba(255,255,255,.05);
  --chip-hover-border: rgba(255,255,255,.25);
  --badge-bg: rgba(255,255,255,.07);
  --region-bg: rgba(255,255,255,.06);
  --row-border: rgba(255,255,255,.05);
  --row-hover: rgba(255,255,255,.03);
  --surface: rgba(255,255,255,.02);
  --code-bg: rgba(255,255,255,.07);
  --ver-na-bg: rgba(255,255,255,.06);
  --topbar-bg: rgba(10,14,26,.82);
  --radius: 14px;
  --maxw: 1280px;
}

/* ---------- 亮色主题（跟随系统或手动切换） ---------- */
html[data-theme="light"] {
  --bg: #f3f5fa; --bg-soft: #eceff7; --card: #ffffff; --card-2: #f0f3fb;
  --border: rgba(15,23,42,.12);
  --text: #1a2438; --text-dim: #46536e; --text-faint: #71809c;
  --hover: rgba(15,23,42,.05); --chip-bg: rgba(15,23,42,.045);
  --chip-hover-border: rgba(15,23,42,.3); --badge-bg: rgba(15,23,42,.055);
  --region-bg: rgba(15,23,42,.05); --row-border: rgba(15,23,42,.07);
  --row-hover: rgba(15,23,42,.035); --surface: rgba(15,23,42,.02);
  --code-bg: rgba(15,23,42,.06); --ver-na-bg: rgba(15,23,42,.06);
  --topbar-bg: rgba(255,255,255,.86);
  --green: #059669; --gold: #b45309; --red: #dc2626;
}
html[data-theme="light"] .topbar { background: var(--topbar-bg); }
html[data-theme="light"] .hero {
  background:
    radial-gradient(900px 400px at 80% -10%, rgba(99,102,241,.1), transparent 60%),
    radial-gradient(700px 380px at 10% 0%, rgba(34,211,238,.08), transparent 60%),
    var(--bg-soft);
}
html[data-theme="light"] .rate-hi { color: #059669; }
html[data-theme="light"] .rate-mid { color: #b45309; }
html[data-theme="light"] .rate-lo { color: #dc2626; }
html[data-theme="light"] .conf-hi { background: rgba(5,150,105,.1); color: #047857; }
html[data-theme="light"] .conf-mid { background: rgba(180,83,9,.1); color: #b45309; }
html[data-theme="light"] .conf-lo { background: rgba(220,38,38,.08); color: #b91c1c; }
html[data-theme="light"] .dyn-date { color: #0e7490; background: rgba(14,116,144,.07); border-color: rgba(14,116,144,.22); }
html[data-theme="light"] .ver-v3 { background: rgba(5,150,105,.1); color: #047857; }
html[data-theme="light"] .ver-v2 { background: rgba(180,83,9,.1); color: #b45309; }
html[data-theme="light"] .tag-official { background: rgba(79,70,229,.09); color: #4338ca; }
html[data-theme="light"] .tag-tool { background: rgba(8,145,178,.09); color: #0e7490; }
html[data-theme="light"] .tag-cloud { background: rgba(5,150,105,.09); color: #047857; }
html[data-theme="light"] .tag-team { background: rgba(180,83,9,.09); color: #b45309; }
html[data-theme="light"] .badge-accent { background: rgba(79,70,229,.1); border-color: rgba(79,70,229,.35); color: #4338ca; }
html[data-theme="light"] .est-badge { background: rgba(15,23,42,.08); color: #46536e; }
html[data-theme="light"] .tok-cell { color: #6d28d9; }


* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; scroll-padding-top: 64px; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", system-ui, -apple-system, sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--accent-2); text-decoration: none; }
a:hover { text-decoration: underline; }

/* ---------- 顶栏 ---------- */
.topbar {
  position: sticky; top: 0; z-index: 100;
  background: var(--topbar-bg);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}
.topbar-inner {
  max-width: var(--maxw); margin: 0 auto; padding: 12px 24px;
  display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
}
.brand { font-size: 17px; font-weight: 800; color: var(--text); letter-spacing: .5px; }
.brand:hover { text-decoration: none; }
.brand em { font-style: normal; background: linear-gradient(90deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
.brand-mark {
  display: inline-block; padding: 2px 8px; margin-right: 8px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  border-radius: 8px; color: #fff; font-size: 13px; font-weight: 700;
}
.topnav { display: flex; gap: 4px; flex-wrap: wrap; }
.topnav a {
  color: var(--text-dim); font-size: 14px; padding: 6px 12px; border-radius: 8px;
}
.topnav a:hover { color: var(--text); background: var(--hover); text-decoration: none; }
.theme-btn {
  background: var(--chip-bg); border: 1px solid var(--border); color: var(--text);
  padding: 5px 11px; border-radius: 999px; font-size: 15px; line-height: 1.2;
  cursor: pointer; transition: all .18s; white-space: nowrap;
}
.theme-btn:hover { border-color: var(--chip-hover-border); background: var(--hover); }

/* ---------- Hero ---------- */
.hero {
  position: relative; overflow: hidden;
  border-bottom: 1px solid var(--border);
  background:
    radial-gradient(900px 400px at 80% -10%, rgba(99,102,241,.22), transparent 60%),
    radial-gradient(700px 380px at 10% 0%, rgba(34,211,238,.14), transparent 60%),
    var(--bg-soft);
}
.hero-inner { max-width: var(--maxw); margin: 0 auto; padding: 64px 24px 48px; }
.hero-badges { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
.badge {
  display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 12.5px;
  background: var(--badge-bg); border: 1px solid var(--border); color: var(--text-dim);
}
.badge-accent { background: rgba(99,102,241,.18); border-color: rgba(99,102,241,.5); color: #c7d2fe; }
.hero h1 {
  font-size: clamp(30px, 5vw, 48px); font-weight: 800; line-height: 1.2; letter-spacing: .5px;
}
.hero h1 em {
  font-style: normal;
  background: linear-gradient(90deg, #818cf8, #22d3ee);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.hero-sub { margin-top: 18px; max-width: 880px; color: var(--text-dim); font-size: 16.5px; }
.hero-sub strong { color: var(--text); }
.hero-note { margin-top: 14px; max-width: 880px; color: var(--text-faint); font-size: 13.5px; }

/* ---------- 统计卡 ---------- */
.stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-top: 32px; }
.stat {
  background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 18px 20px; position: relative; overflow: hidden;
}
.stat::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  background: linear-gradient(180deg, var(--accent), var(--accent-2));
}
.stat .num { font-size: 26px; font-weight: 800; line-height: 1.2; }
.stat .num small { font-size: 13px; font-weight: 500; color: var(--text-dim); margin-left: 2px; }
.stat .lbl { font-size: 12.5px; color: var(--text-dim); margin-top: 4px; }

/* ---------- Section ---------- */
.section { max-width: var(--maxw); margin: 0 auto; padding: 52px 24px 8px; }
.section-head { margin-bottom: 22px; }
.section-head h2 { font-size: 24px; font-weight: 800; letter-spacing: .3px; }
.section-head p { margin-top: 8px; color: var(--text-dim); font-size: 14.5px; max-width: 1000px; }
.section-head p strong { color: var(--text); }

/* ---------- 控件 ---------- */
.controls { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin-bottom: 18px; }
.chip-group { display: flex; gap: 8px; flex-wrap: wrap; }
.chip {
  padding: 7px 16px; border-radius: 999px; font-size: 13.5px; cursor: pointer;
  background: var(--chip-bg); color: var(--text-dim);
  border: 1px solid var(--border); transition: all .18s;
}
.chip:hover { color: var(--text); border-color: var(--chip-hover-border); }
.chip.active {
  background: linear-gradient(135deg, rgba(99,102,241,.35), rgba(34,211,238,.25));
  border-color: rgba(99,102,241,.65); color: #fff;
}
.controls-table { align-items: center; }
.legend-inline { display: flex; gap: 16px; margin-left: auto; font-size: 12.5px; color: var(--text-dim); flex-wrap: wrap; }
.legend-inline span { display: inline-flex; align-items: center; gap: 6px; }
.legend-inline i { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
.search-input, .select {
  background: var(--card); border: 1px solid var(--border); color: var(--text);
  padding: 9px 14px; border-radius: 10px; font-size: 14px; outline: none;
}
.search-input:focus, .select:focus { border-color: var(--accent); }
.search-input { min-width: 260px; }
.select option { background: var(--card); }
.table-count { color: var(--text-faint); font-size: 13px; margin-left: auto; }

/* ---------- 图表卡 ---------- */
.chart-card {
  background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 18px 12px 6px; margin-bottom: 10px;
}
.chart { width: 100%; min-height: 420px; }
.chart-fixed { height: 480px; }
.chart-note { color: var(--text-faint); font-size: 13px; margin: 8px 6px 20px; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media (max-width: 980px) { .grid-2 { grid-template-columns: 1fr; } }

.card-text { padding: 22px; font-size: 14px; color: var(--text-dim); }
.card-text h3 { color: var(--text); font-size: 16px; margin-bottom: 10px; }
.card-text .hl { color: var(--text); font-weight: 700; }
.card-text p { margin-bottom: 10px; }
.card-text .mini-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 13px; }
.card-text .mini-table td { padding: 6px 8px; border-bottom: 1px dashed var(--border); }
.card-text .mini-table td:last-child { text-align: right; color: var(--text); font-weight: 600; }

/* ---------- 免费入口 ---------- */
.free-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; margin-bottom: 20px; }
.free-card {
  background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 18px 20px; position: relative; transition: border-color .2s;
}
.free-card:hover { border-color: rgba(52,211,153,.45); }
.free-card .fc-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
.free-card .fc-vendor { font-size: 15px; font-weight: 800; }
.free-card .fc-plan { font-size: 13px; color: var(--accent-2); }
.free-card .fc-region { font-size: 11.5px; padding: 2px 8px; border-radius: 999px; background: var(--region-bg); color: var(--text-dim); }
.free-card .fc-quota { margin-top: 10px; font-size: 13.5px; color: var(--text-dim); }
.free-card .fc-quota b { color: var(--green); font-weight: 700; }
.free-card .fc-tools { margin-top: 6px; font-size: 12.5px; color: var(--text-faint); }
.free-card .fc-link { display: inline-block; margin-top: 10px; font-size: 12.5px; }

/* ---------- 表格 ---------- */
.table-wrap {
  background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
  overflow: auto; max-height: 780px; margin-bottom: 10px;
}
table { width: 100%; border-collapse: collapse; font-size: 13px; }
#planTable { min-width: 1080px; }
.card-text .mini-table, .mini-table { min-width: 0; }

/* 额度深度对比表 */
#metricsTable { min-width: 1100px; font-size: 12.5px; }

/* 快速决策卡 */
.quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 10px; }
.quick-card {
  background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 22px 24px; position: relative; overflow: hidden; transition: transform .2s, border-color .2s;
}
.quick-card:hover { transform: translateY(-3px); border-color: rgba(99,102,241,.4); }
.quick-card::before {
  content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, var(--qc-accent, var(--accent)), var(--accent-2));
}
.quick-card .qc-icon { font-size: 28px; margin-bottom: 10px; }
.quick-card .qc-title { font-size: 13px; color: var(--text-dim); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .5px; }
.quick-card .qc-value { font-size: 22px; font-weight: 800; line-height: 1.3; margin-bottom: 6px; }
.quick-card .qc-value em { font-style: normal; color: var(--qc-accent, var(--accent)); }
.quick-card .qc-sub { font-size: 13px; color: var(--text-dim); line-height: 1.55; }
.quick-card .qc-sub b { color: var(--text); }
.quick-card .qc-tag {
  display: inline-block; margin-top: 12px; padding: 3px 10px; border-radius: 999px;
  font-size: 11.5px; background: rgba(99,102,241,.12); color: #a5b4fc;
}
#metricsTable th, #metricsTable td { padding: 8px 10px; white-space: nowrap; }
#metricsTable .sticky-col {
  position: sticky; left: 0; z-index: 5;
  background: var(--card-2); min-width: 140px; text-align: left;
}
#metricsTable tbody td:first-child {
  position: sticky; left: 0; background: var(--card); z-index: 3;
  font-weight: 700; color: var(--text); max-width: 180px; overflow: hidden; text-overflow: ellipsis;
}
#metricsTable tbody tr:hover td:first-child { background: var(--card-2); }
.tps-cell { color: var(--text-dim); font-size: 12px; }
.tok-cell { color: #c4b5fd; font-weight: 600; }
.val-cell { color: var(--gold); font-weight: 600; }
.rate-cell { font-weight: 800; font-size: 13px; }
.rate-hi { color: var(--green); }
.rate-mid { color: var(--gold); }
.rate-lo { color: var(--red); }
.ver-tag { display: inline-block; padding: 1px 7px; border-radius: 999px; font-size: 11px; }
.ver-v3 { background: rgba(52,211,153,.16); color: #6ee7b7; }
.ver-v2 { background: rgba(245,158,11,.14); color: #fcd34d; }
.ver-na { background: var(--ver-na-bg); color: var(--text-faint); }

/* 估算行与依据列 */
.est-row td { background: rgba(245,158,11,.03); }
.est-row:hover td { background: rgba(245,158,11,.07) !important; }
.est-badge {
  display: inline-block; padding: 1px 5px; border-radius: 4px; font-size: 10px;
  background: rgba(139,152,184,.18); color: #c3cde4; vertical-align: 1px;
}
.prov-cell { font-size: 11.5px; color: var(--text-dim); }
.conf {
  display: inline-block; padding: 1px 6px; border-radius: 999px;
  font-size: 10.5px; margin-right: 5px; font-weight: 600;
}
.conf-hi { background: rgba(52,211,153,.16); color: #6ee7b7; }
.conf-mid { background: rgba(245,158,11,.15); color: #fcd34d; }
.conf-lo { background: rgba(248,113,113,.14); color: #fca5a5; }

/* 估算方法论折叠块 */
.method-box {
  margin-top: 14px; margin-bottom: 10px;
  border: 1px dashed rgba(154,167,194,.3); border-radius: 12px;
  padding: 14px 20px; background: var(--surface);
}
.method-box summary { cursor: pointer; color: var(--accent-2); font-size: 14px; font-weight: 600; user-select: none; }
.method-box summary:hover { color: #a5f3fc; }
.method-box ol { margin: 14px 0 8px 22px; display: grid; gap: 10px; font-size: 13.5px; color: var(--text-dim); line-height: 1.7; }
.method-box b { color: var(--text); }
.method-box code { background: var(--code-bg); padding: 1px 6px; border-radius: 4px; font-size: 12px; }
.method-box p { font-size: 12.5px; color: var(--text-faint); margin-top: 10px; line-height: 1.7; }
thead th {
  position: sticky; top: 0; z-index: 5;
  background: var(--card-2); color: var(--text-dim); text-align: left;
  padding: 11px 12px; font-weight: 600; white-space: nowrap; border-bottom: 1px solid var(--border);
}
thead th.sortable { cursor: pointer; user-select: none; }
thead th.sortable:hover { color: var(--text); }
thead th.sort-active { color: var(--accent-2); }
tbody td {
  padding: 10px 12px; border-bottom: 1px solid var(--row-border);
  vertical-align: top; color: var(--text-dim);
}
tbody tr:hover td { background: var(--row-hover); }
td.td-vendor { color: var(--text); font-weight: 700; white-space: nowrap; }
td.td-plan { color: var(--text); white-space: nowrap; }
td.td-price { color: var(--gold); font-weight: 700; white-space: nowrap; }
td.td-price .sub { color: var(--text-faint); font-weight: 400; }
.td-quota { min-width: 260px; max-width: 380px; }
.td-models, .td-note { min-width: 160px; max-width: 260px; }
.tag {
  display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11.5px; white-space: nowrap;
}
.tag-official { background: rgba(99,102,241,.16); color: #a5b4fc; }
.tag-tool { background: rgba(34,211,238,.13); color: #67e8f9; }
.tag-cloud { background: rgba(52,211,153,.14); color: #6ee7b7; }
.tag-team { background: rgba(245,158,11,.14); color: #fcd34d; }
.region-cn { color: #fca5a5; }
.region-intl { color: var(--text-faint); }

/* ---------- 动态 ---------- */
.dynamics-list { list-style: none; margin-bottom: 20px; display: grid; gap: 10px; }
.dynamics-list li {
  background: var(--card); border: 1px solid var(--border); border-radius: 12px;
  padding: 14px 18px; font-size: 14.5px; color: var(--text-dim); display: flex; gap: 12px;
  align-items: flex-start;
}
.dynamics-list li::before { content: "⚡"; flex-shrink: 0; margin-top: 1px; }
.dyn-date {
  flex-shrink: 0; height: fit-content; white-space: nowrap;
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; font-size: 12px;
  color: #a5f3fc; background: rgba(34,211,238,.08); border: 1px solid rgba(34,211,238,.18);
  padding: 2px 8px; border-radius: 6px; margin-top: 2px;
}
.dyn-body { flex: 1; }
.dyn-src { display: inline-block; margin-left: 8px; font-size: 12px; color: var(--accent-2); white-space: nowrap; }
.dyn-src:hover { color: #a5f3fc; }

/* ---------- 来源 ---------- */
.source-card {
  background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 22px; font-size: 13.5px; color: var(--text-dim); margin-bottom: 10px;
}
.source-card h3 { color: var(--text); font-size: 16px; margin-bottom: 12px; }
.source-group { margin-bottom: 12px; }
.source-group b { color: var(--text); font-size: 13.5px; }
.source-group ul { list-style: none; margin-top: 6px; padding-left: 4px; }
.source-group li { padding: 2px 0; word-break: break-all; }
.source-group a { font-size: 12.5px; }
.uncertain-list { list-style: none; display: grid; gap: 8px; }
.uncertain-list li { padding-left: 18px; position: relative; }
.uncertain-list li::before { content: "•"; position: absolute; left: 4px; color: var(--gold); }

/* ---------- 页脚 ---------- */
.footer { border-top: 1px solid var(--border); margin-top: 60px; padding: 28px 24px 40px; text-align: center; color: var(--text-faint); font-size: 13px; }

/* ECharts 深色文字 */
.dark-text { fill: var(--text-dim); }

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.vue", "src/**/*.js", "src/**/*.d.ts", "js/**/*.js", "js/**/*.d.ts"],
  "exclude": ["src/**/*.test.js", "src/test/**", "node_modules"]
}

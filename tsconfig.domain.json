{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".domain-types",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@domain/*": [
        "src/domain/*"
      ],
      "@app/*": [
        "src/application/*"
      ],
      "@state/*": [
        "src/state/*"
      ],
      "@browser/*": [
        "src/browser/*"
      ],
      "@generated/*": [
        "src/generated/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "types/globals.d.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/test/**",
    "node_modules"
  ]
}
